<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
  "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
  "https://checkstyle.org/dtds/configuration_1_3.dtd">
<module name="Checker">
  <property name="severity" value="error"/>
  <property name="fileExtensions" value="java"/>

  <module name="SuppressionFilter">
    <property name="file" value="${checkstyle.suppressions.file}"/>
    <property name="optional" value="false"/>
  </module>

  <module name="SuppressionSingleFilter">
    <property name="id" value="noThreadWaitInTests"/>
    <property name="files" value="[\\/]src[\\/]main[\\/]"/>
  </module>

  <module name="RegexpMultiline">
    <property name="id" value="logThrowableNotMessage"/>
    <property name="format" value="\blog\.(warn|error)\([^;]*\.getMessage\(\)\s*\)\s*;"/>
    <property name="message" value="Log the throwable as the last argument, not only getMessage()."/>
  </module>

  <module name="TreeWalker">
    <module name="TodoComment">
      <property name="id" value="noTicketIdsInComments"/>
      <property name="format" value="EUDPA-\d+|\b(c|cv|d|q|inc|req)-\d{3}\b|Design Release|DR2\.?1|\bRuled\b|real service"/>
      <message key="todo.match" value="Comments must not carry ticket keys, backlog or ruling ids, release names or session words."/>
    </module>

    <module name="RegexpSinglelineJava">
      <property name="id" value="noTicketIdsInTestTitles"/>
      <property name="format" value="@DisplayName\(.*(EUDPA-\d+|\b(c|cv|d|q|inc|req)-\d{3}\b|Design Release|DR2\.?1|\bRuled\b|real service)"/>
      <property name="ignoreComments" value="true"/>
      <property name="message" value="Test titles must not carry ticket keys, backlog or ruling ids, release names or session words."/>
    </module>

    <module name="MethodName">
      <property name="id" value="noTicketIdsOrHistoryInMethodNames"/>
      <property name="format" value="^(?!.*(EUDPA\d|Eudpa\d|BeforeTheChange|AfterTheChange|DesignRelease|Dr21|RealService))[a-z][a-zA-Z0-9_]*$"/>
      <message key="name.invalidPattern" value="Method name ''{0}'' must not carry ticket keys, release names, session words or before/after history."/>
    </module>

    <module name="RegexpSinglelineJava">
      <property name="id" value="noThreadWaitInTests"/>
      <property name="format" value="\bThread\.(onSpinWait|sleep)\s*\("/>
      <property name="ignoreComments" value="true"/>
      <property name="message" value="Tests must not spin or sleep. Wait on the condition, not on the clock."/>
    </module>
  </module>
</module>
